params {
    // Project Paths
    reads      = "${projectDir}/data/fastq/*_R{1,2}.fastq.gz"
    genome     = "${projectDir}/data/index/genome"
    annotation = "${projectDir}/data/annotation.gtf"
    outdir     = "${projectDir}/results"

    // MultiQC trigger (optional, depending on your main.nf logic)
    multiqc    = true
}

process {
    // Default resources for all processes
    cpus   = 2
    memory = '4 GB'

    // Resource overrides for specific tools
    withName: 'BOWTIE2_ALIGN' {
        cpus = 4
        memory = '8 GB'
    }
    
    withName: 'TRIMGALORE' {
        cpus = 2
    }
}

// Ensure Docker is used in Codespaces to handle software dependencies
docker {
    enabled = true
    autoMountConfigs = true
}

// Reporting - generates a nice summary of the run
report {
    enabled = true
    file    = "${params.outdir}/execution_report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/execution_trace.txt"
}
